{
  "info": {
    "name": "CrawlerData: Google Search (SERP) and Shopping API",
    "description": "Google Search (SERP) data as JSON from the CrawlerData API: organic results, AI Overview with sources, People Also Ask, News, Images, Local, Autocomplete and Google Shopping. 1 credit per request, failed requests are not charged. Set the collection variable api_key (create one at https://app.crawlerdata.com; new accounts with a verified work email get free trial credits). Docs: https://crawlerdata.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_key",
      "value": "",
      "type": "secret"
    }
  ],
  "item": [
    {
      "name": "Google Search (with AI Overview)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"endpoint\": \"google-search\",\n  \"params\": {\n    \"query\": \"what is a serp api\",\n    \"country\": \"us\",\n    \"language\": \"en\",\n    \"device\": \"desktop\",\n    \"page\": 1\n  },\n  \"queue\": \"live\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.crawlerdata.com/v1/jobs",
          "protocol": "https",
          "host": [
            "api",
            "crawlerdata",
            "com"
          ],
          "path": [
            "v1",
            "jobs"
          ]
        },
        "description": "Organic results, ads, AI Overview (text and cited sources), People Also Ask, local pack, top stories, knowledge panel and related searches. device: desktop or mobile."
      },
      "response": []
    },
    {
      "name": "Google Search by city",
