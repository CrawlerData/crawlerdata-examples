          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"endpoint\": \"google-search\",\n  \"params\": {\n    \"query\": \"coffee shops\",\n    \"country\": \"us\",\n    \"location\": \"Austin,Texas,United States\"\n  },\n  \"queue\": \"live\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.crawlerdata.com/v1/jobs",
          "protocol": "https",
          "host": [
            "api",
            "crawlerdata",
            "com"
          ],
          "path": [
            "v1",
            "jobs"
          ]
        },
        "description": "Results as seen from one city: location is the canonical city name."
      },
      "response": []
    },
